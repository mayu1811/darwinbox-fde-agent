# ---------------------------------------------------------------------------
# Darwinbox FDE - AI Data Migration Agent
#
# EVERY value here is optional. With no .env at all the app runs in DEMO MODE:
# deterministic semantic mapping + confidence scoring, no API key, no network.
# ---------------------------------------------------------------------------

# --- general ---------------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./migration.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- LLM (optional) --------------------------------------------------------
# LLM_PROVIDER: none | ollama | openai
#   none    -> DEMO MODE. Deterministic rules only. This is the default.
#   ollama  -> local, free, open source. Start with: ollama serve
#   openai  -> any OpenAI-compatible endpoint (OpenAI, Groq, Together, vLLM...)
#
# The LLM is an ADVISOR only: it may adjust a mapping confidence by at most
# 0.12 and can never pick a target the deterministic layer did not consider.
# If it is unreachable the agent silently falls back to demo mode.
LLM_PROVIDER=none

# Ollama (recommended local option)
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1:8b
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama

# OpenAI-compatible endpoint
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...        # NEVER commit a real key

LLM_TIMEOUT_SECONDS=20
LLM_FALLBACK_TO_DETERMINISTIC=true

# --- autonomy policy -------------------------------------------------------
# Raise these to make the agent more cautious, lower them to make it bolder.
HIGH_CONFIDENCE_THRESHOLD=0.90
MEDIUM_CONFIDENCE_THRESHOLD=0.70
MIN_CONFIDENCE_MARGIN=0.15
MAX_AUTO_REPAIR_ATTEMPTS=2

# --- target API simulation -------------------------------------------------
# "<employee_id>:<attempts that fail before it succeeds>"
#   EMP1009 recovers inside the first push (attempt 3 succeeds)
#   EMP1022 exhausts the first push and only recovers on "Retry failed"
TARGET_TRANSIENT_PROFILE=EMP1009:2,EMP1022:3
MAX_PUSH_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=0.4
AUTO_PUSH_AFTER_RESOLUTION=true

# Slows the agent down so a human can watch it work. Set to 0 for tests.
AGENT_STEP_DELAY_SECONDS=0.35

# --- upload safety ---------------------------------------------------------
UPLOAD_MAX_BYTES=10485760
ALLOWED_UPLOAD_EXTENSIONS=.csv,.xlsx,.xls
